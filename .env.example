# Copy this file to .env and replace every placeholder with local/deployment values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Redis/Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# LLM gateway (never commit the real key)
LLM_BASE_URL=https://chatbot-llm-gateway.pr.mci.dev/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=openai/gpt-oss-120b

# Database sync target (never commit VPS details)
VPS_HOST=your-vps-host-or-ip
VPS_USER=root
REMOTE_DB=/srv/torobche/carfinder/db.sqlite3
REMOTE_SERVICE=torobche
